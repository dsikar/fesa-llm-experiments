{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsikar/fesa-llm-experiments/schemas/capacity-prediction-private-v1.schema.json",
  "title": "Capacity private prediction v1",
  "description": "One planned query. Retries stay on this record through attempt_count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "record_type",
    "run_id",
    "condition_id",
    "query_id",
    "row_identity",
    "pair_group_id",
    "gold_label",
    "terminal_disposition",
    "attempt_count",
    "context_overflow_stage",
    "parsed_prediction",
    "response_received",
    "truncated",
    "input_tokens",
    "output_tokens",
    "latency_seconds",
    "prompt_sha256",
    "response_sha256",
    "membership_hash",
    "demonstration_ids",
    "raw_prompt_ref",
    "raw_response_ref",
    "serving_session_id",
    "endpoint",
    "error_name"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "schema_id": {
      "const": "capacity-prediction-v1"
    },
    "record_type": {
      "const": "prediction"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_id": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "description": "Private query identity. Stripped by the public exporter."
    },
    "row_identity": {
      "type": "string",
      "minLength": 1,
      "description": "Private source-row identity. Stripped by the public exporter."
    },
    "pair_group_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Private pairing key. Aggregate counts do not prove pairing."
    },
    "gold_label": {
      "type": "string",
      "enum": [
        "benign",
        "malicious"
      ]
    },
    "terminal_disposition": {
      "type": "string",
      "enum": [
        "valid",
        "parse_failure",
        "context_overflow",
        "truncated",
        "other_failure",
        "not_attempted"
      ],
      "description": "Exactly one terminal bucket for this planned query."
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Requests for this query, including retries. The query still counts once."
    },
    "context_overflow_stage": {
      "type": "string",
      "enum": [
        "none",
        "preflight",
        "sent"
      ]
    },
    "parsed_prediction": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "benign",
            "malicious"
          ]
        }
      ]
    },
    "response_received": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "latency_seconds": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Hash of the exact rendered prompt. Treated as membership-identifying."
    },
    "response_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Hash of the raw response. Not published."
    },
    "membership_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Private duplicate-group membership hash. Not published."
    },
    "demonstration_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Private demonstration identities used for this query."
    },
    "raw_prompt_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Relative private prompt artifact name."
    },
    "raw_response_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "description": "Relative private response artifact name."
    },
    "serving_session_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "error_name": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
